      "Bash(ls \"C:/Users/Admin/.claude/skills/\" 2>&1 | head -50)",
      "Bash(mkdir -p \"C:/Users/Admin/.claude/skills/frontend-design\")",
      "Bash(curl -sSL https://raw.githubusercontent.com/anthropics/skills/main/skills/frontend-design/LICENSE.txt -o \"C:/Users/Admin/.claude/skills/frontend-design/LICENSE.txt\")",
      "Bash(git clone *)",
