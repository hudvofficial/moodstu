# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# Per-machine local Claude Code MCP servers (chrome-devtools etc.) — has absolute paths
.mcp.json
# Per-machine Antigravity preview server config (launch.json references absolute node paths via dev-wrapper)
.claude/launch.json
.claude/dev-wrapper.cmd

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dev-server*.log
.next-dev*.log

# root-level ad-hoc debug/CLI output (lint, tsc, test runs) — never commit
/*_output.txt
/*_output_*.txt
/test_out*.txt
/lint-results.json
/migration_error.txt
/force-deploy.log
/transcription_output.txt

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# PWA Service Worker (generated on build by @ducanh2912/next-pwa)
public/sw.js
public/sw.js.map
public/workbox-*.js
public/workbox-*.js.map
public/fallback-*.js
public/fallback-*.js.map
public/swe-worker-*.js
public/swe-worker-*.js.map

# supabase
/supabase/.temp/
supabase_update_*.sql

# temporary data
/tmp/
tmp_*.json
.brain/handover.md
.brain/session.json

.openclaw/

# local debug / session artefacts (never commit)
cookies.txt
codex-login.out
codex-login.err
check-rpc-items.*
/*.ps1
/public/visual-test.html

# visual regression screenshots (generated, not tracked)
/screenshots/

# per-machine Claude Code settings & hooks
.claude/settings.local.json
.claude/hooks/

# AI workflow local state
.hermes/
.agents/
.codex/
.engram/
.codegraph/daemon.pid

# Codex/dev-session logs and temporary helpers
/.codex-*.log
/.codex-*.json
/.dev-server*.log
/transcribe.py

# temporary visual regression test (not a permanent spec)
tests/e2e/visual-temp.spec.ts
